.{
    .name = .audit,
    .version = "0.1.13",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.18#05479688417efd7f9627719bf10ae4ab934dcb7e",
            .hash = "dns-0.1.18-x4U-zd2bFQDR2R6kq4VG6tt6FSqh5qkH4RWc-egQrKrt",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.18#d431d1bb72203f51b6922f3a88093cec854dc050",
            .hash = "otel-0.1.18-B0v3liP3NQB05N3TveX5FJIiWYYRm0UGCeMZ0P9bi_ha",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
