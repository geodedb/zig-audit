.{
    .name = .audit,
    .version = "0.1.5",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#a429a8afa8f0f683bbe9cf7054deb588ebb5fe6b",
            .hash = "dns-0.1.7-x4U-zTI-EQB4hvL7YpEsw3hsYWDuesyzwbA7bAe3TrKp",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#cd553d7f14a14022846effc85cab8d5f286ddc0f",
            .hash = "otel-0.1.5-B0v3luELNADeZkDRvx4omSRcxZbqIobqSM6hvFiC05PQ",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
