.{
    .name = .audit,
    .version = "0.1.8",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.9#dc2329d5355dce4097a71a762869d2d89b541dca",
            .hash = "dns-0.1.8-x4U-zaM-EQA4bavPz0btJDlS3QpjWQaEtoRREyRc-Mef",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.8#a43c52592c3c131019fed264da8d8c532c23a531",
            .hash = "otel-0.1.7-B0v3lvwMNADEHMtQzsmbCvC6qxWxlBtVcpdTX-Wb5BnV",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
