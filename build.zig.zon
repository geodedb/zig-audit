.{
    .name = .audit,
    .version = "0.1.0",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#4677b797c9420244f60e3a362337a3f07e2779cc",
            .hash = "dns-0.1.0-x4U-zSE9EQCUiFYHRfhRajKV_LB6OXcjdLmSCmwmynr7",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#efe116b388d43472eaab5b6c24a13725156df417",
            .hash = "otel-0.1.0-B0v3lrgNNAAbt_xZDbOsBAS1bFFkspiibIElaWuVMK4M",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
