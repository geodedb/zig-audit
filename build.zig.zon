.{
    .name = .audit,
    .version = "0.1.5",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#b271294c9424784998183b02e6783328a1208621",
            .hash = "dns-0.1.7-x4U-zZg-EQCtF6Pg73EbX-ZUDdg3iR4GgWruqvt7o8rI",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#214e531c82a3159f5ffe63624e380111e90898c6",
            .hash = "otel-0.1.5-B0v3lvEMNADmMsONSxCyQcCGyAz0TbResIJdK-rM_Pul",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
