.{
    .name = .audit,
    .version = "0.1.22",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.26#803994d9e1f2ecf3f19e5196fb21105e63e1f601",
            .hash = "dns-0.1.26-x4U-zWVmGABFXh_Rq9NEa50OgklKthjeQbaRX70OSQG2",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.27#027fd8cb4799378dca301f1c51ba8b06e73e109c",
            .hash = "otel-0.1.27-B0v3lj-uNQChk7EkatR41wvCa5jN2Vg9GOPaCotOR1Ne",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "examples",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
