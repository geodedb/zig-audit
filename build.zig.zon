.{
    .name = .audit,
    .version = "0.1.5",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#0c10bec0b09c1f3c0b682b351241dac3b98c9888",
            .hash = "dns-0.1.7-x4U-zZg-EQAKXRJ-slpYP0lpmiMqe6zVJTAIrmL4_Bgr",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#64db4c05079b0f9493c6ecbe60ff3571266589d5",
            .hash = "otel-0.1.5-B0v3lvEMNAAIk-gM2fawa7UVOS3Whr1K460ZdcNgPeYn",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
