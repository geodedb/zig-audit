.{
    .name = .audit,
    .version = "0.1.15",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.21#356f6fa57f198bc93a80bcbbf56f2cb51823842e",
            .hash = "dns-0.1.20-x4U-zQqcFQCa1Swq4q3wXWCNucsfX1CjepRj-gPdSWw5",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.21#7e4261c3db1ba166384d5df5ff95576a2a62f4b0",
            .hash = "otel-0.1.20-B0v3liX3NQBBDic7ltvLZtBWaKCYjca_83Q3WwlLyfL_",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
