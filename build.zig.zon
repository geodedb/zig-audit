.{
    .name = .audit,
    .version = "0.1.1",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#v0.1.3",
            .hash = "dns-0.1.3-x4U-zZk8EQANTwaEYXs0fHUZRCRki1d0b1Pd1UrCOe9i",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#v0.1.2",
            .hash = "otel-0.1.2-B0v3lrgLNAD0ReUud59gKUAKcmloqqJvaU_JUo0BjfMW",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
