.{
    .name = .audit,
    .version = "0.1.17",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.22#4de26109da18524a4422643539336ad7242c18e8",
            .hash = "dns-0.1.22-x4U-zQqcFQAkACfVh_QEo5OinvuyYqRoXSgcnb1qepMd",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.22#7857f80c39b805b3e9b1ce1ff74ce2abe236afa0",
            .hash = "otel-0.1.22-B0v3liX3NQCMsW_nJF7Vk94koaVLHtP_NNNlKXTAtzEz",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
