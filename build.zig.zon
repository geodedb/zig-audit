.{
    .name = .audit,
    .version = "0.1.0",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git#4420b77efe1ab5891e0356eb16ac76ff000f1fd7",
            .hash = "dns-0.1.0-x4U-zSE9EQC_Ov3rE8YIB44MkkhaPPm4o3w9Ak6whpTw",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#a1647d2f26f73ec2042b12ab60c1ee3effb7d411",
            .hash = "otel-0.1.0-B0v3lrgNNAC_Asch0mgFZ-vhA2cXGmBss4K1xNjmTnzA",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
