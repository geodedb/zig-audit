.{
    .name = .audit,
    .version = "0.1.25",
    .fingerprint = 0x9218ff7908edd427,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .dns = .{
            .url = "git+https://gitlab.com/devnw/zig/dns.git?ref=v0.1.29#3c184d3678ee8709f47a7f5ec58cba17376dc5d7",
            .hash = "dns-0.1.29-x4U-zSeCGACiftNR0oJoHugYo1ElseP7po9H8LkiXyNO",
        },
        // Lazy: the package is only fetched when `-Dwith_otel=true` —
        // `b.lazyDependency("otel", ...)` short-circuits the resolution
        // when the build option is off, keeping the disabled build
        // dependency-free (and the symbol set otel-free, verified by
        // `otel/scripts/verify-consumer-noop.sh`).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.30#dbf58bae612ef3f5f78c62c130b4c6d63f5aa297",
            .hash = "otel-0.1.30-B0v3lrGuNQDL0D3_KAb6qK6MaYmz2QeutCp0Sg3SL1H7",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "examples",
        "benchmarks",
        "LICENSE",
        "README.md",
    },
}
